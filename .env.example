# ============================================================
# HelpNOW — Variáveis de Ambiente (exemplo)
# Copie este arquivo para .env.dev, .env.test ou .env.prod
# e preencha com seus próprios valores.
# NUNCA envie arquivos .env reais para o repositório!
# ============================================================

# Flask
FLASK_APP=app.py
FLASK_ENV=development        # development | testing | production
FLASK_DEBUG=1                # 1 para desenvolvimento, 0 para produção

# Segurança (gere uma chave forte: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=troque-por-uma-chave-secreta-forte

# Banco de dados (SQLite padrão para dev)
# DATABASE_URL=sqlite:///helpnow.db

# E-mail (necessário apenas para produção)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=sua-senha-de-aplicativo
MAIL_DEFAULT_SENDER=HelpNOW <seu-email@gmail.com>

# Testes
# TESTING=1
# WTF_CSRF_ENABLED=0
